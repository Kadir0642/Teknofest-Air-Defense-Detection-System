import cv2
import numpy as np
import math
from ultralytics import YOLO


# =========================================================
# 1) MODEL VE PARAMETRELER
# =========================================================
MODEL_PATH = "best.pt"
model = YOLO(MODEL_PATH)

YOLO_IMGSZ = 640
YOLO_CONF = 0.25


# Alt kırmızı aralığı
lower_red1 = np.array([0, 120, 70])
upper_red1 = np.array([10, 255, 255])
# Üst kırmızı aralığı
lower_red2 = np.array([170, 120, 70])
upper_red2 = np.array([180, 255, 255])

mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
mask2 = cv2.inRange(hsv, lower_red2, upper_red2)
mask = cv2.bitwise_or(mask1, mask2)

#LOWER_ORANGE = np.array([5, 120, 120], dtype=np.uint8)
#UPPER_ORANGE = np.array([25, 255, 255], dtype=np.uint8)

KERNEL = np.ones((5, 5), np.uint8)

MIN_CONTOUR_AREA = 20
MIN_CIRCULARITY = 0.50
MIN_RADIUS = 2


# =========================================================
# 2) BBOX İÇİNDE BALON MERKEZİ TESPİTİ
# =========================================================
def detect_orange_balloon_center(frame, bbox):
    x1, y1, x2, y2 = bbox

    x1 = max(0, int(x1))
    y1 = max(0, int(y1))
    x2 = min(frame.shape[1], int(x2))
    y2 = min(frame.shape[0], int(y2))

    if x2 <= x1 or y2 <= y1:
        return None

    roi = frame[y1:y2, x1:x2]

    if roi.size == 0:
        return None

    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)

    mask = cv2.inRange(
        hsv,
        LOWER_ORANGE,
        UPPER_ORANGE
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        KERNEL
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        KERNEL
    )

    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    if not contours:
        return None

    largest_contour = max(contours, key=cv2.contourArea)
    area = cv2.contourArea(largest_contour)

    if area < MIN_CONTOUR_AREA:
        return None

    perimeter = cv2.arcLength(largest_contour, True)

    if perimeter == 0:
        return None

    circularity = 4 * math.pi * area / (perimeter * perimeter)

    if circularity < MIN_CIRCULARITY:
        return None

    (cx_roi, cy_roi), radius = cv2.minEnclosingCircle(largest_contour)

    if radius < MIN_RADIUS:
        return None

    global_x = int(cx_roi + x1)
    global_y = int(cy_roi + y1)

    return {
        "center": (global_x, global_y),
        "radius": float(radius),
        "area": float(area),
        "circularity": float(circularity),
    }


# =========================================================
# 3) YOLOV8 + BYTETRACK TESPİT VE TAKİP
# =========================================================
def detect_and_track(frame):
    results = model.track(
        source=frame,
        imgsz=YOLO_IMGSZ,
        conf=YOLO_CONF,
        tracker="bytetrack.yaml",
        persist=True,
        verbose=False
    )

    detections = []

    if len(results) == 0:
        return detections

    result = results[0]

    if result.boxes is None:
        return detections

    for box in result.boxes:
        xyxy = box.xyxy[0].cpu().numpy().astype(int)
        x1, y1, x2, y2 = xyxy.tolist()

        class_id = int(box.cls[0].item()) if box.cls is not None else -1
        confidence = float(box.conf[0].item()) if box.conf is not None else 0.0
        track_id = int(box.id[0].item()) if box.id is not None else -1

        class_name = model.names.get(class_id, str(class_id))

        balloon_info = detect_orange_balloon_center(
            frame,
            (x1, y1, x2, y2)
        )

        detections.append({
            "track_id": track_id,
            "class_id": class_id,
            "class_name": class_name,
            "confidence": confidence,
            "bbox": (x1, y1, x2, y2),
            "balloon": balloon_info,
        })

    return detections


# =========================================================
# 4) EN KÜÇÜK ID'Lİ NESNEYE KİTLENME
# =========================================================
def select_target_by_smallest_id(detections):
    valid_detections = [
        det for det in detections
        if det["track_id"] != -1
    ]

    if not valid_detections:
        return None

    return min(
        valid_detections,
        key=lambda det: det["track_id"]
    )


# =========================================================
# 5) HEDEF MERKEZ VE HATA DEĞERİ HESABI
# =========================================================
def calculate_target_error(frame, target):
    frame_height, frame_width = frame.shape[:2]

    frame_center_x = frame_width // 2
    frame_center_y = frame_height // 2

    x1, y1, x2, y2 = target["bbox"]

    target_x = (x1 + x2) // 2
    target_y = (y1 + y2) // 2

    if target["balloon"] is not None:
        target_x, target_y = target["balloon"]["center"]

    error_x = target_x - frame_center_x
    error_y = target_y - frame_center_y

    return {
        "target_center": (target_x, target_y),
        "frame_center": (frame_center_x, frame_center_y),
        "error_x": error_x,
        "error_y": error_y,
    }


# =========================================================
# 6) TEK FRAME İŞLEME FONKSİYONU
# =========================================================
def process_frame(frame):
    detections = detect_and_track(frame)

    target = select_target_by_smallest_id(detections)

    if target is None:
        return {
            "detections": detections,
            "selected_target": None,
            "target_error": None,
        }

    target_error = calculate_target_error(frame, target)

    return {
        "detections": detections,
        "selected_target": target,
        "target_error": target_error,
    }
